<div class="container py-4">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" style="color:var(--el-primary);text-decoration:none">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Quản lí khóa học</li>
                </ol>
            </nav>
            <h2>Quản lí khóa học</h2>
        </div>
        <div class="d-flex gap-2">
            <a href="/me/trash/courses" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash3 me-1"></i>Thùng rác ({{deletedCount}})
            </a>
            <a href="/courses/create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Thêm khóa học
            </a>
        </div>
    </div>

    <form name="container-form" method="POST" action="/courses/handle-form-actions">
        <div class="admin-table-wrapper">
            <div class="bulk-action-bar">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="checkbox-all">
                    <label class="form-check-label fw-semibold" for="checkbox-all" style="font-size:0.875rem">
                        Chọn tất cả
                    </label>
                </div>
                <select class="form-select form-select-sm" style="width:auto" name="action">
                    <option value="">-- Hành động --</option>
                    <option value="delete">Xóa tạm thời</option>
                </select>
                <button type="submit" class="btn btn-sm btn-danger check-all-submit-btn disabled">
                    <i class="bi bi-check-lg me-1"></i>Thực hiện
                </button>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th style="width:44px"></th>
                        <th>#</th>
                        <th>Tên khóa học</th>
                        <th>Mã video</th>
                        <th>Slug</th>
                        <th style="width:100px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each courses}}
                    <tr>
                        <td>
                            <input class="form-check-input" name="courseIds[]" type="checkbox" value="{{this._id}}">
                        </td>
                        <td class="text-muted">{{ sum @index 1 }}</td>
                        <td class="fw-semibold">{{this.name}}</td>
                        <td><code style="font-size:0.75rem">{{this.videoId}}</code></td>
                        <td><small class="text-muted">{{this.slug}}</small></td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary me-1" href="/courses/{{this._id}}/edit" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger"
                               data-id="{{this._id}}"
                               data-bs-toggle="modal"
                               data-bs-target="#delete-course-modal"
                               href="#"
                               title="Xóa">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Chưa có khóa học nào.
                            <a href="/courses/create" style="color:var(--el-primary)">Thêm khóa học</a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </form>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="delete-course-modal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-muted" style="font-size:0.9375rem">
                Khóa học sẽ được chuyển vào thùng rác. Bạn có thể khôi phục sau.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button id="btn-delete-course" type="button" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<form method="POST" name="delete-course-form"></form>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var courseId = '';
    var deleteForm = document.forms['delete-course-form'];

    document.getElementById('btn-delete-course').addEventListener('click', function () {
        deleteForm.action = '/courses/' + courseId + '?_method=DELETE';
        deleteForm.submit();
    });

    document.getElementById('delete-course-modal').addEventListener('show.bs.modal', function (event) {
        courseId = event.relatedTarget.dataset.id;
    });

    var checkboxAll = document.getElementById('checkbox-all');
    var courseCheckboxes = document.querySelectorAll('input[name="courseIds[]"]');
    var submitBtn = document.querySelector('.check-all-submit-btn');

    function updateSubmitBtn() {
        var checkedCount = document.querySelectorAll('input[name="courseIds[]"]:checked').length;
        submitBtn.classList.toggle('disabled', checkedCount === 0);
    }

    checkboxAll.addEventListener('change', function () {
        courseCheckboxes.forEach(function (cb) { cb.checked = checkboxAll.checked; });
        updateSubmitBtn();
    });

    courseCheckboxes.forEach(function (cb) {
        cb.addEventListener('change', function () {
            checkboxAll.checked = Array.from(courseCheckboxes).every(function (c) { return c.checked; });
            updateSubmitBtn();
        });
    });
});
</script>
