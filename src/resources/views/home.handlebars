<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <h1 class="hero-title">Học trực tuyến<br>mọi lúc, mọi nơi</h1>
                <p class="hero-subtitle mt-3 mb-4">
                    Nền tảng học video bài giảng chất lượng cao.
                    Học theo tốc độ của bạn, từ cơ bản đến nâng cao.
                </p>
                <div id="hero-actions">
                    <a href="/auth/loginpage" class="hero-cta">
                        <i class="bi bi-play-circle-fill"></i>
                        Bắt đầu học ngay
                    </a>
                </div>
            </div>
            <div class="col-lg-7">
                <div id="heroCarousel" class="carousel slide carousel-fade shadow-lg rounded-3 overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active" data-bs-interval="3000">
                            <img src="https://i.pinimg.com/originals/61/ec/ab/61ecabce5788fe23f0d9e1ae7e5d8fca.jpg" class="d-block w-100" alt="Learning" style="height:280px;object-fit:cover">
                        </div>
                        <div class="carousel-item" data-bs-interval="3500">
                            <img src="https://image.freepik.com/free-vector/online-courses-concept_23-2148524391.jpg" class="d-block w-100" alt="Courses" style="height:280px;object-fit:cover">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

{{#if courses.length}}
<section class="py-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="section-title mb-0">Khóa học nổi bật</h2>
            <a href="/courses/show" class="btn btn-outline-primary btn-sm">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            {{#each courses}}
            <div class="col-sm-6 col-lg-4">
                <div class="course-card">
                    <div class="course-card__img-wrap">
                        <a href="/courses/learn/{{this.slug}}">
                            <img src="{{this.image}}" alt="{{this.name}}" loading="lazy">
                        </a>
                        <div class="course-card__play-overlay">
                            <i class="bi bi-play-circle-fill"></i>
                        </div>
                    </div>
                    <div class="course-card__body">
                        <h5 class="course-card__title">{{this.name}}</h5>
                        <p class="course-card__desc">{{this.description}}</p>
                        <div class="course-card__footer">
                            <a href="/courses/learn/{{this.slug}}" class="course-card__btn">
                                <i class="bi bi-play-fill"></i> Xem video
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>
{{/if}}

<script>
document.addEventListener('DOMContentLoaded', function () {
    if (document.cookie.includes('token')) {
        var el = document.getElementById('hero-actions');
        if (el) {
            el.innerHTML = '<a href="/courses/show" class="hero-cta"><i class="bi bi-grid-fill"></i> Xem tất cả khóa học</a>';
        }
    }
});
</script>
