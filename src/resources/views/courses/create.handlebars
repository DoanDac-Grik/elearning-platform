<div class="container py-4">
    <div class="page-header">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" style="color:var(--el-primary);text-decoration:none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/me/courses" style="color:var(--el-primary);text-decoration:none">Quản lí</a></li>
                <li class="breadcrumb-item active">Đăng khóa học mới</li>
            </ol>
        </nav>
        <h2><i class="bi bi-plus-circle me-2" style="color:var(--el-primary)"></i>Đăng khóa học mới</h2>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="form-card">
                <form method="POST" action="/courses">
                    <div class="mb-3">
                        <label for="name" class="form-label">Tên khóa học <span class="text-danger">*</span></label>
                        <input name="name" id="name" type="text" class="form-control"
                               placeholder="VD: Lập trình Python cơ bản" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Mô tả</label>
                        <textarea name="description" id="description" class="form-control"
                                  rows="3" placeholder="Mô tả nội dung khóa học..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="videoId" class="form-label">
                            <i class="bi bi-youtube text-danger me-1"></i>Mã YouTube Video
                        </label>
                        <input name="videoId" id="videoId" type="text" class="form-control"
                               placeholder="VD: dQw4w9WgXcQ">
                        <div class="form-text">Mã video từ URL YouTube: youtube.com/watch?v=<strong>mã_video</strong></div>
                    </div>
                    <div class="mb-4">
                        <label for="image" class="form-label">
                            <i class="bi bi-image me-1"></i>URL hình ảnh thumbnail
                        </label>
                        <input name="image" id="image" type="url" class="form-control"
                               placeholder="https://example.com/image.jpg">
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Thêm khóa học
                        </button>
                        <a href="/me/courses" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
