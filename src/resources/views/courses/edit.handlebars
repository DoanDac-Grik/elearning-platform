<div class="container py-4">
    <div class="page-header">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" style="color:var(--el-primary);text-decoration:none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/me/stored/courses" style="color:var(--el-primary);text-decoration:none">Quản lí</a></li>
                <li class="breadcrumb-item active">Cập nhật khóa học</li>
            </ol>
        </nav>
        <h2><i class="bi bi-pencil-square me-2" style="color:var(--el-primary)"></i>Cập nhật khóa học</h2>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="form-card">
                <form method="POST" action="/courses/{{course._id}}?_method=PUT">
                    <div class="mb-3">
                        <label for="name" class="form-label">Tên khóa học <span class="text-danger">*</span></label>
                        <input value="{{course.name}}" name="name" id="name" type="text" class="form-control"
                               placeholder="Điền tên" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Mô tả</label>
                        <textarea name="description" id="description" class="form-control" rows="3"
                                  placeholder="Mô tả khóa học...">{{course.description}}</textarea>
                    </div>
                    <div class="mb-3">
                        <label for="videoId" class="form-label">
                            <i class="bi bi-youtube text-danger me-1"></i>Mã YouTube Video
                        </label>
                        <input value="{{course.videoId}}" name="videoId" id="videoId" type="text" class="form-control"
                               placeholder="VD: dQw4w9WgXcQ">
                    </div>
                    <div class="mb-4">
                        <label for="image" class="form-label">
                            <i class="bi bi-image me-1"></i>URL hình ảnh thumbnail
                        </label>
                        <input value="{{course.image}}" name="image" id="image" type="url" class="form-control"
                               placeholder="https://example.com/image.jpg">
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                        </button>
                        <a href="/me/stored/courses" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
